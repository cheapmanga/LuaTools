<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The addon contract. This assembly is what a community addon compiles against, so it is the one
    piece of LuaTools whose public surface is a promise: renaming or resigning anything here breaks
    every addon in the wild. Keep it small, keep it stable, and add rather than change.

    It targets plain net8.0 and does NOT reference WPF. A page is named by Type, so nothing here needs
    the framework that draws it; the host, which does know about WPF, is where a page type is checked for
    actually being a Control. That keeps the contract buildable anywhere and keeps an addon author's
    project file down to a single reference.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LuaTools.Addons</AssemblyName>
    <RootNamespace>LuaTools.Addons</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Addons reference this assembly but must never ship their own copy: the host loads them into
         a context where this type identity has to be THE host's, or every cast across the boundary
         fails with "type X is not type X". Private=false at the reference site enforces it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
