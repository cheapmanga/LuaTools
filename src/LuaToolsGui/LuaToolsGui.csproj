<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LuaTools</AssemblyName>
    <AssemblyTitle>LuaTools</AssemblyTitle>
    <Product>LuaTools</Product>
    <Version>1.1.3</Version>
    <!-- Stamped by publish-standalone.sh (-p:BuildCommit=<short sha>). The compiler appends "+<sha>" to
         AssemblyInformationalVersion, which StandaloneUpdateService reads to tell this build's commit from
         the one the release tag points at. Empty on a plain `dotnet build`/`run`, which disables the check. -->
    <SourceRevisionId Condition="'$(BuildCommit)' != ''">$(BuildCommit)</SourceRevisionId>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Velopack needs a custom Main (Program.Main) that runs before WPF -->
    <StartupObject>LuaToolsGui.Program</StartupObject>
  </PropertyGroup>

  <!-- UseWindowsForms (for the tray NotifyIcon) injects WinForms into the implicit global usings, which
       collides with WPF types (Application, UserControl, DragEventArgs…). We reference WinForms fully
       qualified, so strip those implicit usings to keep WPF unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Let the test project reach internal members (e.g. Program.MatchOsLanguage). -->
  <ItemGroup>
    <InternalsVisibleTo Include="LuaToolsGui.Tests" />
  </ItemGroup>

  <!-- Make App.xaml a Page so the SDK doesn't auto-generate a Main that conflicts with Program.Main -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Embed icon.ico as a resource so the Window Icon="icon.ico" can resolve it at runtime -->
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- Nothing in public/ is bundled anymore. The frontend (luatools.js) is fetched from GitHub releases
       by PluginInstallerService into %AppData%\LuaToolsGui\plugin; the Millennium-aware polyfill is inline
       (CefInjectorService.BuildInlinePolyfill); and the manifest-source list falls back to the hardcoded
       defaults in HttpServerService when api.json is absent. -->


  <!-- Localization RESX. We hand-maintain Strings.Designer.cs (works under dotnet watch), so disable the
       SDK's auto-generated designer to avoid a duplicate Strings class. zh-Hans builds a satellite asm. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings*.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!--
    The achievement host (src/LuaTools.SamHost) is a separate x86 / .NET Framework 4.8 executable: it
    has to be, since steamclient.dll is 32-bit and can't be loaded into this process. LuaTools runs it
    rather than referencing it, so the reference below carries no assembly and the exe is copied by
    hand into both the build output (dev runs) and the publish output (what Velopack packs).
  -->
  <ItemGroup>
    <!-- Referenced only so restore + build ordering cover the host; nothing is referenced from it.
         Without this, building LuaToolsGui.csproj on its own leaves the host unrestored and its net48
         reference-assemblies package missing (MSB3644). SkipGetTargetFrameworkProperties is what lets
         a net8.0-windows project point at a net48 one at all. -->
    <ProjectReference Include="..\LuaTools.SamHost\LuaTools.SamHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <!-- The host is x86/net48 and must not inherit this project's TFM or a win-x64 RID: publishing
           with -r win-x64 would otherwise fail it with NETSDK1032 (RID vs PlatformTarget=x86). -->
      <UndefineProperties>TargetFramework;RuntimeIdentifier;SelfContained;PublishReadyToRun;PublishSingleFile;PublishTrimmed</UndefineProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="_BuildSamHost">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\LuaTools.SamHost\LuaTools.SamHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishReadyToRun;PublishSingleFile;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_SamHostOutput" />
    </MSBuild>
  </Target>

  <Target Name="CopySamHostToOutput" AfterTargets="Build" DependsOnTargets="_BuildSamHost">
    <Copy SourceFiles="@(_SamHostOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySamHostToPublish" AfterTargets="Publish" DependsOnTargets="_BuildSamHost">
    <Copy SourceFiles="@(_SamHostOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
