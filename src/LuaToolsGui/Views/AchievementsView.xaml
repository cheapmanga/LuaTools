<UserControl
    x:Class="LuaToolsGui.Views.AchievementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:AchievementsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Page-size ComboBox item display: localized label, English key stays the bound value. -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Ach_Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Ach_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!-- Search -->
        <ui:TextBox
            Grid.Row="1"
            Margin="0,14,0,0"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Loading -->
        <StackPanel
            Grid.Row="2"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Ach_Loading}" />
        </StackPanel>

        <!-- Empty -->
        <TextBlock
            Grid.Row="2"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="#9ca3af"
            Text="{Binding EmptyMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <!-- Game grid -->
        <vwp:VirtualizingItemsControl
            x:Name="GameScroller"
            Grid.Row="2"
            Margin="0,14,0,0"
            ItemsSource="{Binding Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Width="248"
                        Height="180"
                        Margin="0,0,12,12"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="#0DFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Border Height="116" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="10,10,0,0">
                                            <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="12,8,12,10">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#e5e7eb"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11.5"
                                                Foreground="#6b7280"
                                                Text="{Binding CountLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!-- Pager bar: page numbers centered, results-per-page overlaid right (mirrors Manage/Fixes). -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,2"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <Grid
                HorizontalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding PrevPageCommand}"
                    Content="‹"
                    FontSize="14"
                    IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#6b7280"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:Button
                                    Margin="2,0"
                                    Padding="8,4"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="13">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding NextPageCommand}"
                    Content="›"
                    FontSize="14"
                    IsEnabled="{Binding CanGoNext}" />
            </Grid>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- ── Detail flyout ─────────────────────────────────────────── -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="-8,-16,-16,-8"
            Background="#80000000"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="Transparent" MouseLeftButtonUp="Scrim_Click" />
            <Border
                Width="560"
                HorizontalAlignment="Right"
                Background="#1c1c22"
                BorderBrush="#22FFFFFF"
                BorderThickness="1,0,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Close -->
                    <ui:Button
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        Icon="{ui:SymbolIcon Dismiss24}" />

                    <!-- Game header -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0" DataContext="{Binding SelectedGame}">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="#6b7280"
                            Text="{Binding AppIdText}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,44,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="#9ca3af"
                        Text="{Binding ProgressLabel}"
                        Visibility="{Binding IsLoadingAchievements, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Toolbar: filter pills + search + bulk actions -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Command="{Binding SelectStateFilterCommand}"
                                CommandParameter="all"
                                Content="{x:Static res:Strings.Ach_Filter_All}"
                                FontSize="11.5">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Command="{Binding SelectStateFilterCommand}"
                                CommandParameter="unlocked"
                                Content="{x:Static res:Strings.Ach_Filter_Unlocked}"
                                FontSize="11.5">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterUnlocked}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                Padding="10,4"
                                Command="{Binding SelectStateFilterCommand}"
                                CommandParameter="locked"
                                Content="{x:Static res:Strings.Ach_Filter_Locked}"
                                FontSize="11.5">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterLocked}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>

                        <ui:TextBox
                            Margin="0,10,0,0"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{x:Static res:Strings.Ach_SearchPlaceholder}"
                            Text="{Binding AchievementSearch, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,6,0"
                                Command="{Binding UnlockAllCommand}"
                                Content="{x:Static res:Strings.Ach_UnlockAll}"
                                Icon="{ui:SymbolIcon LockOpen24}"
                                IsEnabled="{Binding NotBusy}" />
                            <ui:Button
                                Margin="0,0,6,0"
                                Command="{Binding LockAllCommand}"
                                Content="{x:Static res:Strings.Ach_LockAll}"
                                Icon="{ui:SymbolIcon LockClosed24}"
                                IsEnabled="{Binding NotBusy}" />
                            <ui:Button
                                Command="{Binding RevertCommand}"
                                Content="{x:Static res:Strings.Ach_Revert}"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                IsEnabled="{Binding HasChanges}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Loading -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Visibility="{Binding IsLoadingAchievements, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Ach_Detail_Loading}" />
                    </StackPanel>

                    <!-- Error / nothing to show -->
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Foreground="#f87171"
                        Text="{Binding DetailError}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding DetailError, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Achievement list -->
                    <ListBox
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Achievements}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Visibility="{Binding IsLoadingAchievements, Converter={StaticResource InverseBoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="Row"
                                    Padding="10,8"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="48"
                                            Height="48"
                                            Background="#11FFFFFF"
                                            ClipToBounds="True"
                                            CornerRadius="6">
                                            <Image Source="{Binding Icon, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#e5e7eb"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11.5"
                                                Foreground="#9ca3af"
                                                Text="{Binding DisplayDescription}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="#6b7280"
                                                Text="{Binding UnlockLabel}"
                                                Visibility="{Binding UnlockLabel, Converter={StaticResource NullToCollapsed}}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="#f59e0b"
                                                Text="{x:Static res:Strings.Ach_ProtectedBadge}"
                                                Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <CheckBox
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAchieved}"
                                            IsEnabled="{Binding CanToggle}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Staged change: accent the row so unsaved edits are obvious. -->
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#1Aa78bfa" />
                                        <Setter TargetName="Row" Property="BorderBrush" Value="#55a78bfa" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer: unsaved count + save / reset -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:ProgressRing
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="#a78bfa"
                                Text="{Binding ChangeLabel}"
                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,6,0"
                                Command="{Binding ResetProgressCommand}"
                                Content="{x:Static res:Strings.Ach_Reset}"
                                Icon="{ui:SymbolIcon Delete24}"
                                IsEnabled="{Binding NotBusy}" />
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding SaveCommand}"
                                Content="{x:Static res:Strings.Ach_Save}"
                                Icon="{ui:SymbolIcon Save24}"
                                IsEnabled="{Binding HasChanges}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
