<UserControl
    x:Class="LuaToolsGui.Views.DenuvoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sub-tabs. The two panels stay mounted and we toggle visibility, so switching never
             re-runs their Loaded/LoadAsync and never drops what the user has typed. -->
        <StackPanel
            Grid.Row="0"
            Margin="24,20,24,4"
            Orientation="Horizontal">
            <ui:Button
                x:Name="TabValidator"
                Appearance="Primary"
                Click="TabValidator_Click"
                Content="{x:Static res:Strings.Nav_Validator}" />
            <ui:Button
                x:Name="TabTokeer"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Click="TabTokeer_Click"
                Content="Tokeer" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ContentControl x:Name="ValidatorHost" />
            <ContentControl x:Name="TokeerHost" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
