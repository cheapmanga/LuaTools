<UserControl
    x:Class="LuaToolsGui.Views.ValidatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ValidatorViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Val_Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static res:Strings.Val_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Game + options  -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Val_Game}" />
                    <!--  The installed games Steam knows about, so nobody has to look up an appid.  -->
                    <ComboBox
                        DisplayMemberPath="Display"
                        IsEnabled="{Binding NotRunning}"
                        ItemsSource="{Binding Games}"
                        SelectedItem="{Binding SelectedGame}" />
                </StackPanel>

                <CheckBox
                    Grid.Column="1"
                    Margin="16,26,0,0"
                    VerticalAlignment="Top"
                    Content="{x:Static res:Strings.Val_LockVersion}"
                    IsChecked="{Binding LockVersion}"
                    IsEnabled="{Binding NotRunning}"
                    ToolTip="{x:Static res:Strings.Val_LockVersion_Hint}" />
            </Grid>

            <!--  What the run sends. Amber, because it is a caution rather than an offer or a result: the
                  script uploads a machine report and hands back the paste's public address as the code.  -->
            <Border
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14,12"
                Background="#14f59e0b"
                BorderBrush="#40f59e0b"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#f59e0b"
                        Text="{x:Static res:Strings.Val_Consent_Header}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Val_Consent_Body}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        Margin="0,10,0,0"
                        Content="{x:Static res:Strings.Val_Consent_Check}"
                        IsChecked="{Binding ConsentGiven}"
                        IsEnabled="{Binding NotRunning}" />
                </StackPanel>
            </Border>

            <!--  Run, progress, log, report code  -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding RunCommand}"
                        Content="{x:Static res:Strings.Val_Run}"
                        Icon="{ui:SymbolIcon Play24}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Status}" />
                </StackPanel>

                <ProgressBar
                    Grid.Row="1"
                    Height="3"
                    Margin="0,12,0,0"
                    Maximum="100"
                    Value="{Binding Progress, Mode=OneWay}"
                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />

                <!--  The script's own output, unedited: it is the thing actually doing the work, and a
                      summary would hide the step that failed.

                      A ListBox rather than an ItemsControl purely for its virtualizing panel: a run can
                      print thousands of lines, and an unvirtualized StackPanel would build a TextBlock for
                      every one of them and crawl. Selection is styled out - nothing here is selectable.  -->
                <Border
                    Grid.Row="2"
                    MinHeight="200"
                    MaxHeight="420"
                    Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <ListBox
                        x:Name="LogList"
                        Padding="12,10"
                        Background="Transparent"
                        PreviewMouseWheel="Log_PreviewMouseWheel"
                        BorderThickness="0"
                        ItemsSource="{Binding Log}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Padding="14,12"
                    Background="#1422c55e"
                    BorderBrush="#4022c55e"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasReportCode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#22c55e"
                                Text="{x:Static res:Strings.Val_Report_Header}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="15"
                                Text="{Binding ReportCode}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{x:Static res:Strings.Val_Report_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding CopyReportCodeCommand}"
                            Content="{x:Static res:Strings.Val_Report_Copy}"
                            Icon="{ui:SymbolIcon Copy24}" />
                    </Grid>
                </Border>

                <!--  Apply the code the bot sends back: the last step of the Denuvo round-trip, on the
                      same page. It's a Tokeer redeem, so it writes the tickets straight into Steam.  -->
                <Border
                    Grid.Row="4"
                    Margin="0,12,0,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Static res:Strings.Val_Apply_Header}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static res:Strings.Val_Apply_Body}"
                            TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                IsEnabled="{Binding NotApplying}"
                                PlaceholderText="{x:Static res:Strings.Val_Apply_Placeholder}"
                                Text="{Binding BotCode, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding ApplyBotCodeCommand}"
                                Content="{x:Static res:Strings.Val_Apply_Action}"
                                Icon="{ui:SymbolIcon Checkmark24}" />
                        </Grid>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="{Binding ApplyStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasApplyStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#22c55e" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#f87171" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
