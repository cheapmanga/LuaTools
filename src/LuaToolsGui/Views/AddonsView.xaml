<UserControl
    x:Class="LuaToolsGui.Views.AddonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AddonsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <!-- One ScrollViewer for the page. Nothing inside it scrolls on its own: a nested scroller marks
             every wheel event handled, even sitting at its own end, and silently traps the wheel for
             whatever is below it. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="8,16,16,24">

                <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Addons_Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="13"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Addons_Subtitle}"
                    TextWrapping="Wrap" />

                <!-- Restart notice -->
                <ui:InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="{Binding RestartNeeded}"
                    Message="{x:Static res:Strings.Addons_RestartBody}"
                    Severity="Informational"
                    Title="{x:Static res:Strings.Addons_RestartTitle}" />

                <!-- Empty state -->
                <Border
                    Margin="0,16,0,0"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Addons_EmptyTitle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Addons_EmptyBody}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding OpenFolderCommand}"
                                Content="{x:Static res:Strings.Addons_OpenFolder}"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"
                                Content="{x:Static res:Strings.Addons_Refresh}"
                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Installed addons -->
                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Addons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="#9ca3af"
                                                Text="{Binding Version}" />
                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="#9ca3af"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" />

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="#9ca3af"
                                            Text="{Binding Contributes}" />

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Text="{Binding Status}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ui:ToggleSwitch
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ui:Button
                        Command="{Binding OpenFolderCommand}"
                        Content="{x:Static res:Strings.Addons_OpenFolder}"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="{x:Static res:Strings.Addons_Refresh}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </StackPanel>

                <!-- Loader messages. Only worth the room when something had something to say. -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Addons_Diagnostics}"
                    Visibility="{Binding Diagnostics.Count, Converter={StaticResource CountToVis}}" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,0,0,3"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#9ca3af"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
