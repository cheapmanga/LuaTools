<UserControl
    x:Class="LuaToolsGui.Views.TokeerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TokeerViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Tokeer_Title}" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static res:Strings.Tokeer_Subtitle}"
                TextWrapping="Wrap" />

            <!--  Redeem  -->
            <Border
                Margin="0,18,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Tokeer_Redeem_Header}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Tokeer_Redeem_Body}"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            CharacterCasing="Upper"
                            IsEnabled="{Binding NotBusy}"
                            MaxLength="32"
                            PlaceholderText="{x:Static res:Strings.Tokeer_Code_Placeholder}"
                            Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Command="{Binding RedeemCommand}"
                            Content="{x:Static res:Strings.Tokeer_Redeem}"
                            Icon="{ui:SymbolIcon KeyMultiple24}" />
                    </Grid>

                    <!--  The store's own wording on failure: it knows why (already used, wrong machine,
                          expired) better than anything this page could guess.  -->
                    <TextBlock
                        Margin="0,10,0,0"
                        Text="{Binding Status}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#22c55e" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#f87171" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  What leaves the machine, said plainly rather than buried in a privacy note nobody reads.  -->
            <TextBlock
                Margin="2,10,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{x:Static res:Strings.Tokeer_Sends}"
                TextWrapping="Wrap" />

            <!--  Generate: the tickets Steam already cached for a game you own, handed to the store.  -->
            <Border
                Margin="0,18,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Tokeer_Generate_Header}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Tokeer_Generate_Body}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,12,0,6"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Tokeer_Generate_Game}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            DisplayMemberPath="Display"
                            IsEnabled="{Binding NotBusy}"
                            ItemsSource="{Binding Games}"
                            SelectedItem="{Binding SelectedGame}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding GenerateCommand}"
                            Content="{x:Static res:Strings.Tokeer_Generate}"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#f87171"
                        Text="{Binding GenerateStatus}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasGenerateStatus, Converter={StaticResource BoolToVis}}" />

                    <Border
                        Margin="0,12,0,0"
                        Padding="14,12"
                        Background="#1422c55e"
                        BorderBrush="#4022c55e"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasGeneratedCode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#22c55e"
                                    Text="{x:Static res:Strings.Tokeer_Generated_Header}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="Consolas"
                                    FontSize="18"
                                    Text="{Binding GeneratedCode}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{x:Static res:Strings.Tokeer_Generated_Hint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding CopyGeneratedCodeCommand}"
                                Content="{x:Static res:Strings.Common_Copy}"
                                Icon="{ui:SymbolIcon Copy24}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="2,14,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{x:Static res:Strings.Tokeer_Credit}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
